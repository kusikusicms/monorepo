{
  "name": "kusikusicms/monorepo",
  "description": "Monorepo for KusikusiCMS packages and apps.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "illuminate/database": "^12.0",
    "illuminate/filesystem": "^12.0",
    "illuminate/routing": "^12.0",
    "illuminate/support": "^12.0",
    "illuminate/view": "^12.0",
    "pugx/shortid-php": "^1.3"
  },
  "require-dev": {
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "KusikusiCMS\\Models\\": "packages/models/src/",
      "KusikusiCMS\\Website\\": "packages/website/src/",
      "KusikusiCMS\\Media\\": "packages/media/src/",
      "KusikusiCMS\\Admin\\": "packages/admin/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KusikusiCMS\\Models\\Tests\\": "packages/models/tests/",
      "KusikusiCMS\\Website\\Tests\\": "packages/website/tests/",
      "KusikusiCMS\\Media\\Tests\\": "packages/media/tests/",
      "KusikusiCMS\\Admin\\Tests\\": "packages/admin/tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "pint"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
