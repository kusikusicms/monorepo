{
  "name": "kusikusicms/admin",
  "description": "Admin UI for managing content in KusikusiCMS.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "illuminate/support": "^13.0",
    "illuminate/view": "^13.0",
    "kusikusicms/models": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "KusikusiCMS\\Admin\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KusikusiCMS\\Admin\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "KusikusiCMS\\Admin\\AdminServiceProvider"
      ]
    },
    "branch-alias": {
      "dev-main": "13.x-dev"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "phpunit/phpunit": "^13.0"
  },
  "config": {
    "sort-packages": true
  }
}
