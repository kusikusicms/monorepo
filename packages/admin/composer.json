{
  "name": "kusikusicms/admin",
  "description": "Admin UI for managing content in KusikusiCMS.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "illuminate/support": "^12.0",
    "illuminate/view": "^12.0",
    "kusikusicms/models": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "KusikusiCMS\\Admin\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KusikusiCMS\\Admin\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "KusikusiCMS\\Admin\\AdminServiceProvider"
      ]
    },
    "branch-alias": {
      "dev-main": "12.x-dev"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.0"
  },
  "config": {
    "sort-packages": true
  }
}
