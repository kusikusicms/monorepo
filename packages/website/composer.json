{
  "name": "kusikusicms/website",
  "description": "Website/router manager for KusikusiCMS.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "illuminate/support": "^13.0",
    "illuminate/routing": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "KusikusiCMS\\Website\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KusikusiCMS\\Website\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "KusikusiCMS\\Website\\WebsiteServiceProvider"
      ]
    },
    "branch-alias": {
      "dev-main": "13.x-dev"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "phpunit/phpunit": "^13.0"
  },
  "config": {
    "sort-packages": true
  }
}
