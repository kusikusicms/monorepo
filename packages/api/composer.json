{
  "name": "kusikusicms/api",
  "description": "Versioned JSON API for KusikusiCMS: token and SPA auth, entities, capabilities and extension hooks.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "illuminate/auth": "^13.0",
    "illuminate/console": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/routing": "^13.0",
    "illuminate/support": "^13.0",
    "kusikusicms/acl": "^13.0",
    "kusikusicms/models": "^13.0",
    "laravel/sanctum": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "KusikusiCMS\\Api\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KusikusiCMS\\Api\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "KusikusiCMS\\Api\\ApiServiceProvider"
      ]
    },
    "branch-alias": {
      "dev-main": "13.x-dev"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "phpunit/phpunit": "^13.0"
  },
  "config": {
    "sort-packages": true
  }
}
