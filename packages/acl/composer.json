{
  "name": "kusikusicms/acl",
  "description": "Entity authorization for KusikusiCMS.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "illuminate/auth": "^13.0",
    "illuminate/console": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/support": "^13.0",
    "kusikusicms/models": "^13.0",
    "laravel/prompts": "^0.3.25",
    "spatie/laravel-permission": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "KusikusiCMS\\Acl\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KusikusiCMS\\Acl\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "KusikusiCMS\\Acl\\AclServiceProvider"
      ]
    },
    "branch-alias": {
      "dev-main": "13.x-dev"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "phpunit/phpunit": "^13.0"
  },
  "config": {
    "sort-packages": true
  }
}